# --- CV Oviedo ---
# Claves de Firebase de cada entorno. `.env.example` sí va al repositorio.
.env.local
.env.*.local

# Credenciales de publicación: la cuenta de servicio de Google Play y los
# certificados de Apple NO se suben nunca.
secretos/
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision

# Salida de las compilaciones locales de EAS
/build

# Registros que deja el emulador de Firebase al correr las pruebas de reglas
firestore-debug.log
ui-debug.log
firebase-debug.log

# `google-services.json` SÍ va al repositorio: no es un secreto (lleva el id del
# proyecto y una clave de API que ya viaja dentro de la app), y sin él la
# compilación de Android no puede registrar el móvil en FCM.
#
# Lo que NO va nunca es la clave de cuenta de servicio que se sube a Expo para
# poder enviar las notificaciones. Esa sí abre la puerta al proyecto entero.
firebase-adminsdk*.json
*-firebase-adminsdk-*.json

# Materiales de la ficha de las tiendas: los PNG se regeneran con
# `npm run tienda`. La descripción es texto escrito a mano y sí va al repo.
/tienda/*.png
entregas/
