# Copia este fichero a `.env.local` y rellena con los datos de tu proyecto de
# Firebase (Consola → Configuración del proyecto → Tus apps → App web).
#
# Estas claves NO son secretas: van dentro de la app compilada de todas formas.
# Lo que protege los datos son las reglas de firestore.rules.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=cv-oviedo.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=cv-oviedo
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=cv-oviedo.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Raíz de la web del club. Para probar contra un servidor local, algo como
# http://192.168.1.40:3000 (la IP del ordenador en la red, no localhost: el
# móvil no comparte el loopback).
EXPO_PUBLIC_WEB_BASE=https://clubvoleiboloviedo.com
