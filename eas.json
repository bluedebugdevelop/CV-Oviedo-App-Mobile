{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_WEB_BASE": "https://clubvoleiboloviedo.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./secretos/google-play.json",
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "appleId": "CAMBIAR@correo.com",
        "ascAppId": "CAMBIAR",
        "appleTeamId": "CAMBIAR"
      }
    }
  }
}
