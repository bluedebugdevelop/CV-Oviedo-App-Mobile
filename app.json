{
  "expo": {
    "name": "CV Oviedo",
    "slug": "cv-oviedo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cvoviedo",
    "icon": "./assets/icono/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "primaryColor": "#1560bd",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.cvoviedo",
      "buildNumber": "1",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "CV Oviedo",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cvoviedo",
      "versionCode": 2,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icono/adaptive-foreground.png",
        "monochromeImage": "./assets/icono/adaptive-monochrome.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.CAMERA",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icono/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icono/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1560bd"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icono/notificacion.png",
          "color": "#2b7fe0",
          "defaultChannel": "avisos"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "El club usa tus fotos solo para las imágenes que publiques en la web (noticias, equipos y patrocinadores). Solo se sube la foto que elijas."
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/memoria-gradle",
      "expo-background-task",
      "./plugins/firma-release",
      "./plugins/icono-grande"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "web": {
        "base": "https://clubvoleiboloviedo.com"
      },
      "router": {},
      "eas": {
        "projectId": "6e3fb271-c578-4c88-ba4d-b034da2e1750"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "owner": "adriest"
  }
}
